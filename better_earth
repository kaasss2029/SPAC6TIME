<script>

    /* ==========================================================
       CELESTRAK
    ========================================================== */

    const CELESTRAK_API_URL =
        "https://celestrak.org/NORAD/elements/gp.php?GROUP=stations&FORMAT=JSON";



    /* ==========================================================
       GEOJSON
       
       LOCAL FILE FIRST
       REMOTE FALLBACK SECOND
    ========================================================== */

    const LOCAL_EARTH_URL =
        "data/ne_110m_land.geojson";


    const REMOTE_EARTH_URL =
        "https://raw.githubusercontent.com/nvkelso/natural-earth-vector/master/geojson/ne_110m_land.geojson";



    /* ==========================================================
       FETCH CELESTRAK
    ========================================================== */

    async function fetchCelesTrakData() {

        const CACHE_KEY =
            "orbitguard_celestrak_stations";

        const CACHE_TIME_KEY =
            "orbitguard_celestrak_stations_time";

        const CACHE_MAX_AGE =
            2 * 60 * 60 * 1000;


        try {

            const cached =
                localStorage.getItem(
                    CACHE_KEY
                );

            const cachedTime =
                Number(
                    localStorage.getItem(
                        CACHE_TIME_KEY
                    ) || 0
                );


            if (
                cached &&
                Date.now() - cachedTime <
                CACHE_MAX_AGE
            ) {

                console.log(
                    "Using cached CelesTrak data"
                );

                return JSON.parse(cached);
            }

        }
        catch (error) {

            console.warn(
                "Cache unavailable:",
                error
            );
        }



        async function fetchWithTimeout(
            url,
            timeout
        ) {

            return Promise.race([

                fetch(url),

                new Promise(
                    (_, reject) => {

                        setTimeout(
                            () =>
                                reject(
                                    new Error(
                                        "Request timed out"
                                    )
                                ),
                            timeout
                        );

                    }
                )

            ]);

        }



        try {

            const response =
                await fetchWithTimeout(
                    CELESTRAK_API_URL,
                    10000
                );


            if (!response.ok) {

                throw new Error(
                    `HTTP ${response.status}`
                );
            }


            const data =
                await response.json();


            try {

                localStorage.setItem(
                    CACHE_KEY,
                    JSON.stringify(data)
                );

                localStorage.setItem(
                    CACHE_TIME_KEY,
                    Date.now().toString()
                );

            }
            catch (error) {

                console.warn(
                    "Could not cache data"
                );

            }


            return data;

        }
        catch (directError) {

            console.warn(
                "Direct CelesTrak failed:",
                directError
            );


            const proxyURL =
                "https://api.allorigins.win/raw?url=" +
                encodeURIComponent(
                    CELESTRAK_API_URL
                );


            const response =
                await fetchWithTimeout(
                    proxyURL,
                    15000
                );


            if (!response.ok) {

                throw new Error(
                    "CelesTrak fallback failed"
                );
            }


            return await response.json();

        }

    }



    /* ==========================================================
       EARTH VISUALIZATION
    ========================================================== */

    async function render3DOrbits(satellites) {

        const traces = [];

        const now =
            new Date();


        const EARTH_RADIUS =
            6371;

        const LAND_RADIUS =
            6374;



        /* ======================================================
           LAT/LON → XYZ
        ====================================================== */

        function latLonToXYZ(
            lon,
            lat,
            radius
        ) {

            const lonRad =
                lon *
                Math.PI /
                180;

            const latRad =
                lat *
                Math.PI /
                180;


            return {

                x:
                    radius *
                    Math.cos(latRad) *
                    Math.cos(lonRad),

                y:
                    radius *
                    Math.cos(latRad) *
                    Math.sin(lonRad),

                z:
                    radius *
                    Math.sin(latRad)

            };

        }



        /* ======================================================
           EARTH SPHERE
        ====================================================== */

        function addEarthSphere() {

            const res = 50;

            const x = [];
            const y = [];
            const z = [];

            for (
                let i = 0;
                i <= res;
                i++
            ) {

                const lat =
                    Math.PI *
                    i /
                    res -
                    Math.PI / 2;


                for (
                    let j = 0;
                    j <= res;
                    j++
                ) {

                    const lon =
                        2 *
                        Math.PI *
                        j /
                        res;


                    x.push(
                        EARTH_RADIUS *
                        Math.cos(lat) *
                        Math.cos(lon)
                    );


                    y.push(
                        EARTH_RADIUS *
                        Math.cos(lat) *
                        Math.sin(lon)
                    );


                    z.push(
                        EARTH_RADIUS *
                        Math.sin(lat)
                    );

                }

            }


            traces.push({

                type: "mesh3d",

                x,
                y,
                z,

                alphahull: 0,

                color: "#16406b",

                opacity: 0.9,

                name: "Earth",

                showlegend: false,

                hoverinfo: "skip"

            });

        }



        /* ======================================================
           ADD LAND POLYGON
        ====================================================== */

        function addPolygon(
            rings
        ) {

            if (
                !rings ||
                rings.length === 0
            ) {

                return;
            }


            const vertices = [];

            const holes = [];

            let vertexCount = 0;



            rings.forEach(
                (ring, ringIndex) => {

                    if (
                        !ring ||
                        ring.length < 3
                    ) {

                        return;
                    }


                    if (
                        ringIndex > 0
                    ) {

                        holes.push(
                            vertexCount
                        );

                    }


                    ring.forEach(
                        point => {

                            const lon =
                                Number(
                                    point[0]
                                );

                            const lat =
                                Number(
                                    point[1]
                                );


                            if (
                                Number.isFinite(
                                    lon
                                ) &&
                                Number.isFinite(
                                    lat
                                )
                            ) {

                                vertices.push(
                                    lon
                                );

                                vertices.push(
                                    lat
                                );

                                vertexCount++;

                            }

                        }
                    );

                }
            );


            if (
                vertices.length < 6
            ) {

                return;
            }



            let triangles;


            try {

                triangles =
                    earcut(
                        vertices,
                        holes,
                        2
                    );

            }
            catch (error) {

                console.error(
                    "Earcut error:",
                    error
                );

                return;
            }


            if (
                !triangles ||
                triangles.length < 3
            ) {

                return;
            }



            const x = [];
            const y = [];
            const z = [];



            for (
                let n = 0;
                n < triangles.length;
                n++
            ) {

                const index =
                    triangles[n];


                const lon =
                    vertices[
                        index * 2
                    ];


                const lat =
                    vertices[
                        index * 2 + 1
                    ];


                const pos =
                    latLonToXYZ(
                        lon,
                        lat,
                        LAND_RADIUS
                    );


                x.push(pos.x);
                y.push(pos.y);
                z.push(pos.z);

            }



            const i = [];
            const j = [];
            const k = [];


            for (
                let n = 0;
                n < triangles.length;
                n += 3
            ) {

                i.push(n);

                j.push(
                    n + 1
                );

                k.push(
                    n + 2
                );

            }



            traces.push({

                type: "mesh3d",

                x,
                y,
                z,

                i,
                j,
                k,

                color: "#6f8f5b",

                opacity: 1,

                flatshading: true,

                name: "Land",

                showlegend: false,

                hoverinfo: "skip"

            });

        }



        /* ======================================================
           LOAD GEOJSON
        ====================================================== */

        async function addEarthLand() {

            let geojson = null;



            /* --------------------------------------------------
               TRY LOCAL FILE
            -------------------------------------------------- */

            try {

                console.log(
                    "Trying local Earth GeoJSON..."
                );


                const response =
                    await fetch(
                        LOCAL_EARTH_URL
                    );


                if (
                    !response.ok
                ) {

                    throw new Error(
                        `HTTP ${response.status}`
                    );

                }


                geojson =
                    await response.json();


                console.log(
                    "Local Earth GeoJSON loaded."
                );

            }
            catch (localError) {

                console.warn(
                    "Local Earth GeoJSON unavailable.",
                    localError
                );


                /* ----------------------------------------------
                   TRY REMOTE FILE
                ---------------------------------------------- */

                try {

                    console.log(
                        "Trying remote Natural Earth GeoJSON..."
                    );


                    const response =
                        await fetch(
                            REMOTE_EARTH_URL
                        );


                    if (
                        !response.ok
                    ) {

                        throw new Error(
                            `HTTP ${response.status}`
                        );

                    }


                    geojson =
                        await response.json();


                    console.log(
                        "Remote Earth GeoJSON loaded."
                    );

                }
                catch (remoteError) {

                    console.error(
                        "Could not load Earth land.",
                        remoteError
                    );

                    return;

                }

            }



            if (
                !geojson ||
                !geojson.features
            ) {

                console.error(
                    "Invalid GeoJSON."
                );

                return;

            }



            let count = 0;



            geojson.features.forEach(
                feature => {

                    if (
                        !feature ||
                        !feature.geometry
                    ) {

                        return;
                    }


                    const geometry =
                        feature.geometry;



                    if (
                        geometry.type ===
                        "Polygon"
                    ) {

                        addPolygon(
                            geometry.coordinates
                        );

                        count++;

                    }



                    else if (
                        geometry.type ===
                        "MultiPolygon"
                    ) {

                        geometry.coordinates
                            .forEach(
                                polygon => {

                                    addPolygon(
                                        polygon
                                    );

                                    count++;

                                }
                            );

                    }

                }
            );


            console.log(
                `Earth land: ${count} polygons processed.`
            );

        }



        /* ======================================================
           ADD EARTH
        ====================================================== */

        addEarthSphere();


        /* ======================================================
           ADD LAND
        ====================================================== */

        await addEarthLand();



        /* ======================================================
           SATELLITE ORBITS
        ====================================================== */

        satellites.forEach(
            (sat, index) => {

                const x = [];
                const y = [];
                const z = [];


                for (
                    let step = 0;
                    step <= 90;
                    step += 2
                ) {

                    const time =
                        new Date(
                            now.getTime() +
                            step *
                            60000
                        );


                    const result =
                        satellite.propagate(
                            sat.satrec,
                            time
                        );


                    if (
                        result &&
                        result.position
                    ) {

                        const pos =
                            result.position;


                        x.push(pos.x);
                        y.push(pos.y);
                        z.push(pos.z);

                    }

                }



                traces.push({

                    type: "scatter3d",

                    mode: "lines",

                    x,
                    y,
                    z,

                    name: sat.name,

                    line: {

                        width:
                            index === 0
                                ? 4
                                : 2
                    }

                });



                if (
                    x.length > 0
                ) {

                    traces.push({

                        type: "scatter3d",

                        mode: "markers",

                        x: [x[0]],

                        y: [y[0]],

                        z: [z[0]],

                        showlegend:
                            false,

                        marker: {

                            size: 5
                        }

                    });

                }

            }
        );



        /* ======================================================
           PLOT
        ====================================================== */

        Plotly.newPlot(

            "orbit",

            traces,

            {

                paper_bgcolor:
                    "#0a111d",

                plot_bgcolor:
                    "#0a111d",


                scene: {

                    bgcolor:
                        "#0a111d",


                    xaxis: {
                        visible: false
                    },

                    yaxis: {
                        visible: false
                    },

                    zaxis: {
                        visible: false
                    },


                    aspectmode:
                        "data",


                    camera: {

                        eye: {

                            x: 1.5,

                            y: 1.5,

                            z: 1.2

                        }

                    }

                },


                margin: {

                    l: 0,

                    r: 0,

                    t: 0,

                    b: 0

                },


                legend: {

                    font: {

                        color:
                            "#9fb0c8",

                        size: 10

                    },

                    bgcolor:
                        "#0a111dcc",

                    x: 0.02,

                    y: 0.98

                }

            },


            {

                displayModeBar:
                    false,

                responsive:
                    true

            }

        );

    }



    /* ==========================================================
       CONJUNCTION CALCULATION
    ========================================================== */

    function computeConjunctions(
        satellites
    ) {

        const events = [];

        const now =
            new Date();


        const STEP_MINUTES = 2;

        const HOURS_AHEAD = 24;


        const totalSteps =
            (
                HOURS_AHEAD * 60
            ) /
            STEP_MINUTES;



        function getState(
            satrec,
            time
        ) {

            const result =
                satellite.propagate(
                    satrec,
                    time
                );


            if (
                !result.position ||
                !result.velocity
            ) {

                return null;
            }


            return {

                position:
                    result.position,

                velocity:
                    result.velocity
            };

        }



        function distanceBetween(
            a,
            b
        ) {

            const dx =
                a.x - b.x;

            const dy =
                a.y - b.y;

            const dz =
                a.z - b.z;


            return Math.sqrt(
                dx * dx +
                dy * dy +
                dz * dz
            );

        }



        function relativeVelocity(
            a,
            b
        ) {

            const vx =
                a.x - b.x;

            const vy =
                a.y - b.y;

            const vz =
                a.z - b.z;


            return Math.sqrt(
                vx * vx +
                vy * vy +
                vz * vz
            );

        }



        for (
            let i = 0;
            i < satellites.length;
            i++
        ) {

            for (
                let j = i + 1;
                j < satellites.length;
                j++
            ) {

                let minimumDistance =
                    Infinity;

                let tcaTime =
                    null;

                let tcaRelativeVelocity =
                    0;



                for (
                    let step = 0;
                    step <= totalSteps;
                    step++
                ) {

                    const time =
                        new Date(
                            now.getTime() +
                            step *
                            STEP_MINUTES *
                            60 *
                            1000
                        );


                    const stateA =
                        getState(
                            satellites[i].satrec,
                            time
                        );


                    const stateB =
                        getState(
                            satellites[j].satrec,
                            time
                        );


                    if (
                        !stateA ||
                        !stateB
                    ) {

                        continue;
                    }


                    const distance =
                        distanceBetween(
                            stateA.position,
                            stateB.position
                        );


                    if (
                        distance <
                        minimumDistance
                    ) {

                        minimumDistance =
                            distance;

                        tcaTime =
                            time;


                        tcaRelativeVelocity =
                            relativeVelocity(
                                stateA.velocity,
                                stateB.velocity
                            );

                    }

                }



                if (
                    !tcaTime ||
                    !isFinite(
                        minimumDistance
                    )
                ) {

                    continue;
                }



                const timeToTcaMinutes =
                    (
                        tcaTime.getTime() -
                        now.getTime()
                    ) /
                    (60 * 1000);



                let riskLevel =
                    "LOW";


                if (
                    minimumDistance < 50
                ) {

                    riskLevel =
                        "HIGH";

                }
                else if (
                    minimumDistance < 500
                ) {

                    riskLevel =
                        "MEDIUM";

                }



                const roundedTca =
                    Math.max(
                        0,
                        Math.round(
                            timeToTcaMinutes
                        )
                    );



                events.push({

                    objA:
                        satellites[i].name,

                    objB:
                        satellites[j].name,

                    dist:
                        minimumDistance.toFixed(
                            1
                        ),

                    distValue:
                        minimumDistance,

                    tca:
                        `${roundedTca} min`,

                    tcaValue:
                        roundedTca,

                    relVel:
                        tcaRelativeVelocity.toFixed(
                            2
                        ),

                    risk:
                        riskLevel,

                    tcaDate:
                        tcaTime

                });

            }

        }



        return events.sort(
            (a, b) =>
                a.tcaValue -
                b.tcaValue
        );

    }



    /* ==========================================================
       RISK SCORE
    ========================================================== */

    function riskScoreFromDistance(
        distanceKm
    ) {

        const clamped =
            Math.max(
                0,
                Math.min(
                    distanceKm,
                    2000
                )
            );


        const score =
            100 -
            (
                clamped /
                2000
            ) *
            95;


        return Math.round(
            Math.max(
                1,
                Math.min(
                    99,
                    score
                )
            )
        );

    }



    /* ==========================================================
       RISK CIRCLE
    ========================================================== */

    function updateRiskCircle(
        score,
        riskLevel
    ) {

        let color =
            "var(--green)";


        if (
            riskLevel === "HIGH"
        ) {

            color =
                "var(--red)";

        }
        else if (
            riskLevel === "MEDIUM"
        ) {

            color =
                "var(--orange)";

        }


        const circle =
            document.getElementById(
                "riskCircle"
            );


        circle.style.background =
            `conic-gradient(
                ${color} 0 ${score}%,
                #172236 ${score}% 100%
            )`;

    }



    /* ==========================================================
       RENDER CONJUNCTIONS
    ========================================================== */

    function renderConjunctions(
        events
    ) {

        const tbody =
            document.getElementById(
                "eventRows"
            );


        tbody.innerHTML = "";


        document.getElementById(
            "cardConjunctions"
        ).innerText =
            events.length;



        const highRisk =
            events.filter(
                e =>
                    e.risk ===
                    "HIGH"
            );


        document.getElementById(
            "cardHighRisk"
        ).innerText =
            highRisk.length
                .toString()
                .padStart(
                    2,
                    "0"
                );



        if (
            events.length === 0
        ) {

            document.getElementById(
                "riskScore"
            ).innerText =
                "0";


            document.getElementById(
                "riskLevel"
            ).innerText =
                "NO EVENTS";


            document.getElementById(
                "riskBadge"
            ).className =
                "badge low";


            document.getElementById(
                "riskBadge"
            ).innerText =
                "NONE";


            updateRiskCircle(
                0,
                "LOW"
            );


            document.getElementById(
                "conjunctionCount"
            ).innerText =
                "Next 24 hours • 0 detected";


            tbody.innerHTML = `

                <tr>

                    <td
                        colspan="6"
                        style="
                            text-align:center;
                            padding:20px;
                        ">

                        No conjunctions detected
                        in the next 24 hours.

                    </td>

                </tr>

            `;


            return;
        }



        const next =
            events[0];



        document.getElementById(
            "cardNextTca"
        ).innerHTML =
            `${next.tcaValue}
             <span style="font-size:14px">
                 min
             </span>`;


        document.getElementById(
            "cardNextPair"
        ).innerText =
            `${next.objA} ↔ ${next.objB}`;



        const score =
            riskScoreFromDistance(
                next.distValue
            );


        document.getElementById(
            "riskScore"
        ).innerText =
            score;


        document.getElementById(
            "riskLevel"
        ).innerText =
            `${next.risk} RISK`;


        document.getElementById(
            "riskDist"
        ).innerText =
            `${next.dist} km`;


        document.getElementById(
            "riskTca"
        ).innerText =
            next.tca;


        document.getElementById(
            "riskVel"
        ).innerText =
            `${next.relVel} km/s`;


        document.getElementById(
            "riskObjA"
        ).innerText =
            next.objA;


        document.getElementById(
            "riskObjB"
        ).innerText =
            next.objB;


        document.getElementById(
            "riskBadge"
        ).className =
            `badge ${next.risk.toLowerCase()}`;


        document.getElementById(
            "riskBadge"
        ).innerText =
            next.risk;


        updateRiskCircle(
            score,
            next.risk
        );



        document.getElementById(
            "conjunctionCount"
        ).innerText =
            `Next 24 hours • ${events.length} detected`;



        events.forEach(
            e => {

                const tr =
                    document.createElement(
                        "tr"
                    );


                tr.innerHTML = `

                    <td class="obj">
                        ${e.objA}
                    </td>

                    <td class="obj">
                        ${e.objB}
                    </td>

                    <td>
                        ${e.dist} km
                    </td>

                    <td>
                        ${e.tca}
                    </td>

                    <td>
                        ${e.relVel} km/s
                    </td>

                    <td>

                        <span
                            class="badge ${e.risk.toLowerCase()}">

                            ${e.risk}

                        </span>

                    </td>

                `;


                tbody.appendChild(
                    tr
                );

            }
        );

    }



    /* ==========================================================
       INITIALIZE DASHBOARD
    ========================================================== */

    async function initDashboard() {

        try {

            console.log(
                "OrbitGuard initializing..."
            );


            const satData =
                await fetchCelesTrakData();


            if (
                !Array.isArray(
                    satData
                ) ||
                satData.length === 0
            ) {

                throw new Error(
                    "CelesTrak returned no data."
                );

            }



            document.getElementById(
                "sysStatus"
            ).innerText =
                "Tracking system online";


            document.getElementById(
                "sysSub"
            ).innerText =
                "CelesTrak feed synced";


            document.getElementById(
                "liveStatus"
            ).innerHTML =
                `<span class="dot"></span>
                 LIVE • ${satData.length} active TLEs`;


            document.getElementById(
                "cardTracked"
            ).innerText =
                satData.length.toLocaleString();



            /* ================================================
               PARSE SATELLITES
            ================================================= */

            const parsedSatellites =
                satData
                    .map(
                        sat => {

                            try {

                                const satrec =
                                    satellite.json2satrec(
                                        sat
                                    );


                                return {

                                    name:
                                        sat.OBJECT_NAME ||
                                        `NORAD ${sat.NORAD_CAT_ID}`,

                                    noradId:
                                        sat.NORAD_CAT_ID,

                                    satrec:
                                        satrec

                                };

                            }
                            catch (error) {

                                console.warn(
                                    "Could not parse:",
                                    sat,
                                    error
                                );

                                return null;

                            }

                        }
                    )
                    .filter(
                        item =>
                            item &&
                            item.satrec
                    );



            if (
                parsedSatellites.length === 0
            ) {

                throw new Error(
                    "No valid satellite orbits."
                );

            }



            /* ================================================
               RENDER 3D EARTH + SATELLITES
            ================================================= */

            await render3DOrbits(
                parsedSatellites
            );



            /* ================================================
               CONJUNCTIONS
            ================================================= */

            const conjunctions =
                computeConjunctions(
                    parsedSatellites
                );


            renderConjunctions(
                conjunctions
            );



            console.log(
                "OrbitGuard initialized successfully."
            );

        }
        catch (error) {

            console.error(
                "Dashboard initialization error:",
                error
            );


            document.getElementById(
                "sysStatus"
            ).innerText =
                "Connection Error";


            document.getElementById(
                "sysSub"
            ).innerText =
                "Unable to load data";


            document.getElementById(
                "sysDot"
            ).style.background =
                "var(--red)";


            document.getElementById(
                "sysDot"
            ).style.boxShadow =
                "0 0 10px var(--red)";


            document.getElementById(
                "liveStatus"
            ).innerHTML =
                `<span class="dot"></span>
                 API OFFLINE`;

        }

    }



    /* ==========================================================
       SEARCH
    ========================================================== */

    document
        .getElementById("search")
        .addEventListener(
            "input",
            event => {

                const query =
                    event.target.value
                        .toLowerCase();


                document
                    .querySelectorAll(
                        "#eventRows tr"
                    )
                    .forEach(
                        row => {

                            row.style.display =
                                row.innerText
                                    .toLowerCase()
                                    .includes(
                                        query
                                    )
                                    ? ""
                                    : "none";

                        }
                    );

            }
        );



    /* ==========================================================
       START
    ========================================================== */

    window.addEventListener(
        "DOMContentLoaded",
        initDashboard
    );

</script>

