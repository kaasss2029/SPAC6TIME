
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>OrbitGuard — Space Debris Tracking</title>
  <script src="https://cdn.plot.ly/plotly-2.35.2.min.js"></script>
  <!-- Added satellite.js for real TLE propagation -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/satellite.js/5.0.0/satellite.min.js"></script>
  <style>
    :root {
      --bg: #070b14;
      --panel: #0d1422;
      --panel2: #111a2b;
      --line: #1c2940;
      --text: #eaf2ff;
      --muted: #7f91ad;
      --cyan: #46d9ff;
      --blue: #5b8cff;
      --red: #ff526d;
      --orange: #ffad4d;
      --green: #42e6a4;
    }

    * {
      box-sizing: border-box
    }

    body {
      margin: 0;
      background: radial-gradient(circle at 70% 10%, #13243c 0, #070b14 38%);
      color: var(--text);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif
    }

    .app {
      display: flex;
      min-height: 100vh
    }

    .sidebar {
      width: 230px;
      background: rgba(7, 11, 20, .92);
      border-right: 1px solid var(--line);
      padding: 24px 16px;
      position: fixed;
      inset: 0 auto 0 0
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 11px;
      font-weight: 800;
      font-size: 19px;
      margin: 4px 10px 35px
    }

    .logoMark {
      width: 34px;
      height: 34px;
      border: 1px solid #2b7190;
      border-radius: 11px;
      display: grid;
      place-items: center;
      color: var(--cyan);
      box-shadow: 0 0 24px #46d9ff22
    }

    .navTitle {
      font-size: 10px;
      color: #50617a;
      letter-spacing: 1.6px;
      margin: 22px 12px 9px;
      text-transform: uppercase
    }

    .nav a {
      display: flex;
      gap: 12px;
      align-items: center;
      padding: 11px 12px;
      border-radius: 10px;
      color: var(--muted);
      text-decoration: none;
      font-size: 13px;
      margin: 3px 0
    }

    .nav a.active,
    .nav a:hover {
      background: #142238;
      color: #fff
    }

    .nav a.active {
      box-shadow: inset 2px 0 var(--cyan)
    }

    .system {
      position: absolute;
      bottom: 22px;
      left: 18px;
      right: 18px;
      padding: 13px;
      border: 1px solid var(--line);
      border-radius: 12px;
      background: #0c1320
    }

    .dot {
      display: inline-block;
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--green);
      box-shadow: 0 0 10px var(--green);
      margin-right: 7px
    }

    .main {
      margin-left: 230px;
      width: calc(100% - 230px);
      padding: 25px 30px
    }

    .top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 23px
    }

    .eyebrow {
      font-size: 11px;
      color: var(--cyan);
      letter-spacing: 1.8px;
      text-transform: uppercase
    }

    h1 {
      margin: 5px 0 0;
      font-size: 27px
    }

    .topRight {
      display: flex;
      align-items: center;
      gap: 12px
    }

    .live {
      font-size: 12px;
      color: #a9b9cf;
      border: 1px solid var(--line);
      padding: 9px 12px;
      border-radius: 9px;
      background: #0c1422
    }

    .search {
      background: #0d1524;
      border: 1px solid var(--line);
      color: #fff;
      padding: 10px 13px;
      border-radius: 9px;
      outline: none;
      width: 190px
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 14px;
      margin-bottom: 16px
    }

    .card {
      background: linear-gradient(145deg, #0e1727, #0a111d);
      border: 1px solid var(--line);
      border-radius: 14px;
      padding: 17px
    }

    .cardHead {
      display: flex;
      justify-content: space-between;
      color: var(--muted);
      font-size: 12px
    }

    .icon {
      color: var(--cyan);
      font-size: 16px
    }

    .value {
      font-size: 28px;
      font-weight: 750;
      margin: 9px 0 3px
    }

    .sub {
      font-size: 11px;
      color: var(--muted)
    }

    .up {
      color: var(--green)
    }

    .grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 310px;
      gap: 16px
    }

    .panel {
      background: rgba(10, 17, 29, .88);
      border: 1px solid var(--line);
      border-radius: 14px;
      overflow: hidden
    }

    .panelTitle {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 15px 17px;
      border-bottom: 1px solid var(--line)
    }

    .panelTitle strong {
      font-size: 13px
    }

    .panelTitle span {
      font-size: 11px;
      color: var(--muted)
    }

    #orbit {
      height: 440px
    }

    .riskBody {
      padding: 22px
    }

    .riskCircle {
      width: 158px;
      height: 158px;
      border-radius: 50%;
      margin: 4px auto 20px;
      display: grid;
      place-items: center;
      background: conic-gradient(var(--red) 0 87%, #172236 87% 100%);
      position: relative
    }

    .riskCircle:after {
      content: "";
      position: absolute;
      width: 128px;
      height: 128px;
      border-radius: 50%;
      background: #0b1320
    }

    .riskNum {
      position: relative;
      z-index: 2;
      text-align: center
    }

    .riskNum b {
      display: block;
      font-size: 40px
    }

    .riskNum small {
      font-size: 10px;
      color: var(--red);
      letter-spacing: 2px
    }

    .details {
      border-top: 1px solid var(--line);
      padding-top: 14px
    }

    .row {
      display: flex;
      justify-content: space-between;
      padding: 9px 0;
      font-size: 12px
    }

    .row span:first-child {
      color: var(--muted)
    }

    .badge {
      padding: 4px 8px;
      border-radius: 6px;
      font-size: 10px;
      font-weight: 700
    }

    .high {
      background: #ff526d18;
      color: var(--red)
    }

    .medium {
      background: #ffad4d18;
      color: var(--orange)
    }

    .low {
      background: #42e6a418;
      color: var(--green)
    }

    .events {
      margin-top: 16px
    }

    .tableWrap {
      overflow: auto
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 12px
    }

    th,
    td {
      text-align: left;
      padding: 12px 15px;
      border-bottom: 1px solid #152136
    }

    th {
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: #60718a;
      font-weight: 600
    }

    td {
      color: #cbd7e8
    }

    tr:hover {
      background: #101a2b
    }

    .obj {
      color: #fff;
      font-weight: 600
    }

    .muted {
      color: var(--muted)
    }

    .footerNote {
      padding: 11px 15px;
      color: #586b86;
      font-size: 10px
    }

    @media(max-width:1000px) {
      .sidebar {
        width: 72px
      }

      .logo span,
      .nav a span,
      .navTitle,
      .system {
        display: none
      }

      .main {
        margin-left: 72px;
        width: calc(100% - 72px)
      }

      .cards {
        grid-template-columns: repeat(2, 1fr)
      }

      .grid {
        grid-template-columns: 1fr
      }
    }
  </style>
</head>

<body>
  <div class="app">
    <aside class="sidebar">
      <div class="logo">
        <div class="logoMark">◉</div><span>OrbitGuard</span>
      </div>
      <div class="navTitle">Monitor</div>
      <div class="nav">
        <a class="active" href="#"><b>⌂</b><span>Overview</span></a>
        <a href="index.html"><b>◎</b><span>Orbital Objects</span></a>
        <a href="grid.html"><b>⚠</b><span>Conjunctions</span></a>
        <a href="#"><b>◌</b><span>Analytics</span></a>
      </div>
      <div class="navTitle">System</div>
      <div class="nav"><a href="#"><b>⚙</b><span>Settings</span></a><a href="#"><b>?</b><span>Documentation</span></a>
      </div>
      <div class="system"><span class="dot" id="sysDot"></span><b style="font-size:11px" id="sysStatus">Connecting...</b>
        <div style="font-size:10px;color:#647690;margin-top:5px" id="sysSub">Syncing CelesTrak...</div>
      </div>
    </aside>

    <main class="main">
      <div class="top">
        <div>
          <div class="eyebrow">LEO Situational Awareness</div>
          <h1>Collision Risk Dashboard</h1>
        </div>
        <div class="topRight">
          <div class="live" id="liveStatus"><span class="dot"></span>FETCHING API...</div>
          <input class="search" id="search" placeholder="Search object...">
        </div>
      </div>

      <section class="cards">
        <div class="card">
          <div class="cardHead">Tracked Objects <span class="icon">◎</span></div>
          <div class="value" id="cardTracked">--</div>
          <div class="sub"><span class="up">Live</span> from CelesTrak GP API</div>
        </div>
        <div class="card">
          <div class="cardHead">Conjunctions (24h) <span class="icon">⌁</span></div>
          <div class="value" id="cardConjunctions">--</div>
          <div class="sub">calculated close approaches</div>
        </div>
        <div class="card">
          <div class="cardHead">High Risk Events <span style="color:var(--red)">●</span></div>
          <div class="value" style="color:var(--red)" id="cardHighRisk">--</div>
          <div class="sub">require immediate review</div>
        </div>
        <div class="card">
          <div class="cardHead">Next Close Approach <span class="icon">◷</span></div>
          <div class="value" id="cardNextTca">--</div>
          <div class="sub" id="cardNextPair">Analyzing data...</div>
        </div>
      </section>

      <div class="grid">
        <section class="panel">
          <div class="panelTitle"><strong>Orbital Environment</strong><span>Propagated +24h • ECI frame (km)</span></div>
          <div id="orbit"></div>
          <div class="footerNote">Live data directly from CelesTrak API • Positions propagated using SGP4 • Distances in km</div>
        </section>

        <aside class="panel">
          <div class="panelTitle"><strong>Risk Monitor</strong><span>Selected event</span></div>
          <div class="riskBody">
            <div class="riskCircle" id="riskCircle">
              <div class="riskNum"><b id="riskScore">--</b><small id="riskLevel">LOADING</small></div>
            </div>
            <div class="details">
              <div class="row"><span>Closest approach</span><b id="riskDist">-- km</b></div>
              <div class="row"><span>Time to TCA</span><b id="riskTca">-- min</b></div>
              <div class="row"><span>Relative velocity</span><b id="riskVel">-- km/s</b></div>
              <div class="row"><span>Object A</span><b id="riskObjA">--</b></div>
              <div class="row"><span>Object B</span><b id="riskObjB">--</b></div>
              <div class="row"><span>Confidence</span><span class="badge high" id="riskBadge">CALCULATING</span></div>
            </div>
          </div>
        </aside>
      </div>

      <section class="panel events">
        <div class="panelTitle"><strong>Upcoming Conjunctions</strong><span id="conjunctionCount">Fetching data...</span></div>
        <div class="tableWrap">
          <table>
            <thead>
              <tr>
                <th>Object A</th>
                <th>Object B</th>
                <th>Closest Approach</th>
                <th>TCA</th>
                <th>Relative Velocity</th>
                <th>Risk</th>
              </tr>
            </thead>
            <tbody id="eventRows">
              <tr><td colspan="6" style="text-align:center; padding: 20px;">Fetching and calculating satellite orbits from CelesTrak...</td></tr>
            </tbody>
          </table>
        </div>
      </section>
    </main>
  </div>

  <script>
    // Selected satellite group to track via CelesTrak API
    const CELESTRAK_API_URL = 'https://celestrak.org/NORAD/elements/gp.php?GROUP=stations&FORMAT=JSON';

    async function initDashboard() {
      try {
        const response = await fetch(CELESTRAK_API_URL);
        const satData = await response.json();

        // Update UI status indicators
        document.getElementById("sysStatus").innerText = "Tracking system online";
        document.getElementById("sysSub").innerText = "CelesTrak feed synced";
        document.getElementById("liveStatus").innerHTML = `<span class="dot"></span>LIVE • ${satData.length} active TLEs`;
        document.getElementById("cardTracked").innerText = satData.length.toLocaleString();

        // Process orbits with SGP4 via satellite.js
        const parsedSatellites = satData.map(sat => {
          const satrec = satellite.jsonToSatrec(sat);
          return {
            name: sat.OBJECT_NAME,
            noradId: sat.NORAD_CAT_ID,
            satrec: satrec
          };
        }).filter(item => item.satrec);

        // Generate 3D Orbits for Plotly Visualization
        render3DOrbits(parsedSatellites.slice(0, 10)); // Display top 10 for performance

        // Calculate sample conjunctions dynamically from real TLE data
        const conjunctions = computeConjunctions(parsedSatellites);
        renderConjunctions(conjunctions);

      } catch (err) {
        console.error("CelesTrak API Fetch Error:", err);
        document.getElementById("sysStatus").innerText = "Connection Error";
        document.getElementById("sysDot").style.background = "var(--red)";
        document.getElementById("sysDot").style.boxShadow = "0 0 10px var(--red)";
        document.getElementById("liveStatus").innerText = "API OFFLINE";
      }
    }

    function render3DOrbits(satellites) {
      const traces = [];
      const now = new Date();

      // Earth Sphere for visual reference
      const earthRadius = 6371; // km

      satellites.forEach((sat, index) => {
        const x = [], y = [], z = [];
        
        // Propagate orbit over 90 minutes (1 full LEO orbit)
        for (let step = 0; step <= 90; step += 2) {
          const time = new Date(now.getTime() + step * 60000);
          const positionAndVelocity = satellite.propagate(sat.satrec, time);
          const gmst = satellite.gstime(time);

          if (positionAndVelocity.position) {
            const pos = positionAndVelocity.position; // ECI Coordinates in km
            x.push(pos.x);
            y.push(pos.y);
            z.push(pos.z);
          }
        }

        // Orbit Line Trace
        traces.push({
          x: x, y: y, z: z,
          mode: "lines",
          type: "scatter3d",
          name: sat.name,
          line: { width: index === 0 ? 4 : 2 }
        });

        // Current Satellite Position Point
        if (x.length > 0) {
          traces.push({
            x: [x[0]], y: [y[0]], z: [z[0]],
            mode: "markers",
            type: "scatter3d",
            showlegend: false,
            marker: { size: 5 }
          });
        }
      });

      Plotly.newPlot("orbit", traces, {
        paper_bgcolor: "#0a111d", plot_bgcolor: "#0a111d",
        scene: {
          bgcolor: "#0a111d",
          xaxis: { visible: false }, yaxis: { visible: false }, zaxis: { visible: false },
          aspectmode: "cube",
          camera: { eye: { x: 1.5, y: 1.5, z: 1.2 } }
        },
        margin: { l: 0, r: 0, t: 0, b: 0 },
        legend: { font: { color: "#9fb0c8", size: 10 }, bgcolor: "#0a111dcc", x: .02, y: .98 }
      }, { displayModeBar: false, responsive: true });
    }

    function computeConjunctions(satellites) {
      const events = [];
      const now = new Date();

      // Simple conjunction calculation between pairs
      for (let i = 0; i < satellites.length; i++) {
        for (let j = i + 1; j < satellites.length; j++) {
          const posA = satellite.propagate(satellites[i].satrec, now);
          const posB = satellite.propagate(satellites[j].satrec, now);

          if (posA.position && posB.position) {
            const dx = posA.position.x - posB.position.x;
            const dy = posA.position.y - posB.position.y;
            const dz = posA.position.z - posB.position.z;
            const distance = Math.sqrt(dx * dx + dy * dy + dz * dz);

            // Calculate relative velocity vector diff
            const vx = (posA.velocity?.x || 0) - (posB.velocity?.x || 0);
            const vy = (posA.velocity?.y || 0) - (posB.velocity?.y || 0);
            const vz = (posA.velocity?.z || 0) - (posB.velocity?.z || 0);
            const relVel = Math.sqrt(vx * vx + vy * vy + vz * vz);

            // Dummy TCA time shift based on index for demonstration
            const tcaMinutes = Math.floor(10 + (i + j) * 7.5); 
            
            let riskLevel = "LOW";
            if (distance < 500) riskLevel = "HIGH";
            else if (distance < 1500) riskLevel = "MEDIUM";

            events.push({
              objA: satellites[i].name,
              objB: satellites[j].name,
              dist: distance.toFixed(1),
              tca: `${tcaMinutes} min`,
              tcaValue: tcaMinutes,
              relVel: relVel.toFixed(1),
              risk: riskLevel
            });
          }
        }
      }

      // Sort by closest approach
      return events.sort((a, b) => parseFloat(a.dist) - parseFloat(b.dist));
    }

    function renderConjunctions(events) {
      const tbody = document.getElementById("eventRows");
      tbody.innerHTML = "";

      // Cards data updating
      document.getElementById("cardConjunctions").innerText = events.length;
      const highRiskEvents = events.filter(e => e.risk === "HIGH");
      document.getElementById("cardHighRisk").innerText = highRiskEvents.length.toString().padStart(2, '0');

      if (events.length > 0) {
        const next = events[0];
        document.getElementById("cardNextTca").innerHTML = `${next.tcaValue}<span style="font-size:14px"> min</span>`;
        document.getElementById("cardNextPair").innerText = `${next.objA} ↔ ${next.objB}`;

        // Populate Selected Risk Monitor Panel with top event
        document.getElementById("riskScore").innerText = next.risk === "HIGH" ? "87" : next.risk === "MEDIUM" ? "54" : "18";
        document.getElementById("riskLevel").innerText = `${next.risk} RISK`;
        document.getElementById("riskDist").innerText = `${next.dist} km`;
        document.getElementById("riskTca").innerText = next.tca;
        document.getElementById("riskVel").innerText = `${next.relVel} km/s`;
        document.getElementById("riskObjA").innerText = next.objA;
        document.getElementById("riskObjB").innerText = next.objB;
        document.getElementById("riskBadge").className = `badge ${next.risk.toLowerCase()}`;
        document.getElementById("riskBadge").innerText = next.risk;
      }

      document.getElementById("conjunctionCount").innerText = `Next 24 hours • ${events.length} detected`;

      // Render Table Rows
      events.forEach(e => {
        const tr = document.createElement("tr");
        tr.innerHTML = `
          <td class="obj">${e.objA}</td>
          <td class="obj">${e.objB}</td>
          <td>${e.dist} km</td>
          <td>${e.tca}</td>
          <td>${e.relVel} km/s</td>
          <td><span class="badge ${e.risk.toLowerCase()}">${e.risk}</span></td>
        `;
        tbody.appendChild(tr);
      });
    }

    // Search bar listener
    document.getElementById("search").addEventListener("input", e => {
      const q = e.target.value.toLowerCase();
      document.querySelectorAll("#eventRows tr").forEach(r => r.style.display = r.innerText.toLowerCase().includes(q) ? "" : "none");
    });

    // Run dashboard initialization on page load
    window.addEventListener('DOMContentLoaded', initDashboard);
  </script>
</body>

</html>

