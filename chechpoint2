  <script>
    // Selected satellite group to track via CelesTrak API
    const CELESTRAK_API_URL = 'https://celestrak.org/NORAD/elements/gp.php?GROUP=stations&FORMAT=JSON';

    async function fetchCelesTrakData() {
      const CACHE_KEY = "orbitguard_celestrak_stations";
      const CACHE_TIME_KEY = "orbitguard_celestrak_stations_time";
      const CACHE_MAX_AGE = 2 * 60 * 60 * 1000; // CelesTrak GP data updates about every 2 hours

      // Reuse recently downloaded data so the page does not repeatedly hit CelesTrak.
      try {
        const cached = localStorage.getItem(CACHE_KEY);
        const cachedTime = Number(localStorage.getItem(CACHE_TIME_KEY) || 0);

        if (cached && Date.now() - cachedTime < CACHE_MAX_AGE) {
          return JSON.parse(cached);
        }
      } catch (cacheError) {
        console.warn("Local cache unavailable:", cacheError);
      }

      const directUrl = CELESTRAK_API_URL;

      // Small helper: race a fetch against a timeout WITHOUT using
      // AbortController/AbortSignal. FIX: some preview/sandbox environments
      // proxy fetch() across a postMessage boundary, and an AbortSignal
      // cannot be structured-cloned across that boundary — passing one in
      // fetch's options throws "DataCloneError: ... AbortSignal object could
      // not be cloned" before the request is even sent. Promise.race gives
      // the same "give up after N ms" behavior without touching fetch's
      // options object at all.
      function fetchWithTimeout(url, options, timeoutMs) {
        return Promise.race([
          fetch(url, options),
          new Promise((_, reject) =>
            setTimeout(() => reject(new Error("Request timed out")), timeoutMs)
          )
        ]);
      }

      // Direct request first.
      try {
        const response = await fetchWithTimeout(directUrl, {
          method: "GET",
          headers: { "Accept": "application/json" },
          cache: "no-store"
        }, 10000);

        if (!response.ok) {
          throw new Error(`CelesTrak HTTP ${response.status}`);
        }

        const data = await response.json();

        try {
          localStorage.setItem(CACHE_KEY, JSON.stringify(data));
          localStorage.setItem(CACHE_TIME_KEY, Date.now().toString());
        } catch (cacheError) {
          console.warn("Could not save API cache:", cacheError);
        }

        return data;
      } catch (directError) {
        console.warn("Direct CelesTrak request failed:", directError);

        // Fallback for pages opened directly from file:// or environments
        // where the browser blocks cross-origin requests.
        const proxyUrl =
          "https://api.allorigins.win/raw?url=" +
          encodeURIComponent(directUrl);

        try {
          const response = await fetchWithTimeout(proxyUrl, {
            method: "GET",
            headers: { "Accept": "application/json" }
          }, 15000);

          if (!response.ok) {
            throw new Error(`Fallback request HTTP ${response.status}`);
          }

          const data = await response.json();

          try {
            localStorage.setItem(CACHE_KEY, JSON.stringify(data));
            localStorage.setItem(CACHE_TIME_KEY, Date.now().toString());
          } catch (cacheError) {
            console.warn("Could not save fallback API cache:", cacheError);
          }

          return data;
        } catch (proxyError) {
          throw new Error(
            `Unable to load CelesTrak data. Direct request: ${directError.message}. ` +
            `Fallback request: ${proxyError.message}`
          );
        }
      }
    }

    async function initDashboard() {
      try {
        const satData = await fetchCelesTrakData();

        if (!Array.isArray(satData) || satData.length === 0) {
          throw new Error("CelesTrak returned no satellite data.");
        }

        // Update UI status indicators
        document.getElementById("sysStatus").innerText = "Tracking system online";
        document.getElementById("sysSub").innerText = "CelesTrak feed synced";
        document.getElementById("liveStatus").innerHTML =
          `<span class="dot"></span>LIVE • ${satData.length} active TLEs`;
        document.getElementById("cardTracked").innerText =
          satData.length.toLocaleString();

        // Process orbits with SGP4 via satellite.js.
        // FIX: satellite.js exposes json2satrec() (not jsonToSatrec, which never
        // existed) for parsing CelesTrak's OMM-as-JSON records. It also only
        // exists from v6.0.0 onward, which is why the <script> tag above is
        // pinned to 6.0.2 instead of the older 5.0.0 build.
        const parsedSatellites = satData.map(sat => {
          try {
            const satrec = satellite.json2satrec(sat);

            return {
              name: sat.OBJECT_NAME || `NORAD ${sat.NORAD_CAT_ID}`,
              noradId: sat.NORAD_CAT_ID,
              satrec: satrec
            };
          } catch (parseError) {
            console.warn("Could not parse satellite:", sat, parseError);
            return null;
          }
        }).filter(item => item && item.satrec);

        if (parsedSatellites.length === 0) {
          throw new Error("No valid satellite orbits could be parsed.");
        }

        // Generate 3D Orbits for Plotly Visualization
        render3DOrbits(parsedSatellites);

        // Calculate closest approaches over the next 24 hours
        const conjunctions = computeConjunctions(parsedSatellites);
        renderConjunctions(conjunctions);

      } catch (err) {
        console.error("CelesTrak API Fetch Error:", err);

        document.getElementById("sysStatus").innerText = "Connection Error";
        document.getElementById("sysSub").innerText = "Unable to load CelesTrak feed";
        document.getElementById("sysDot").style.background = "var(--red)";
        document.getElementById("sysDot").style.boxShadow = "0 0 10px var(--red)";
        document.getElementById("liveStatus").innerHTML =
          `<span class="dot"></span>API OFFLINE`;
        document.getElementById("eventRows").innerHTML =
          `<tr><td colspan="6" style="text-align:center; padding:20px;">
            Could not load satellite data. Open the browser console for details.
          </td></tr>`;
      }
    }

    function render3DOrbits(satellites) {
      const traces = [];
      const now = new Date();

      // Earth sphere for visual reference (FIX: this was declared but never
      // actually plotted before, leaving satellites floating with no reference body).
      const earthRadius = 6371; // km
      const earthRes = 30;
      const ex = [], ey = [], ez = [];
      for (let i = 0; i <= earthRes; i++) {
        const lat = (Math.PI * i) / earthRes - Math.PI / 2;
        for (let j = 0; j <= earthRes; j++) {
          const lon = (2 * Math.PI * j) / earthRes;
          ex.push(earthRadius * Math.cos(lat) * Math.cos(lon));
          ey.push(earthRadius * Math.cos(lat) * Math.sin(lon));
          ez.push(earthRadius * Math.sin(lat));
        }
      }
      traces.push({
        type: "mesh3d",
        x: ex, y: ey, z: ez,
        alphahull: 0,
        color: "#16406b",
        opacity: 0.55,
        name: "Earth",
        showlegend: false,
        hoverinfo: "skip"
      });

      satellites.forEach((sat, index) => {
        const x = [], y = [], z = [];
        
        // Propagate orbit over 90 minutes (1 full LEO orbit)
        for (let step = 0; step <= 90; step += 2) {
          const time = new Date(now.getTime() + step * 60000);
          const positionAndVelocity = satellite.propagate(sat.satrec, time);
          const gmst = satellite.gstime(time);

          if (positionAndVelocity.position) {
            const pos = positionAndVelocity.position; // ECI Coordinates in km
            x.push(pos.x);
            y.push(pos.y);
            z.push(pos.z);
          }
        }

        // Orbit Line Trace
        traces.push({
          x: x, y: y, z: z,
          mode: "lines",
          type: "scatter3d",
          name: sat.name,
          line: { width: index === 0 ? 4 : 2 }
        });

        // Current Satellite Position Point
        if (x.length > 0) {
          traces.push({
            x: [x[0]], y: [y[0]], z: [z[0]],
            mode: "markers",
            type: "scatter3d",
            showlegend: false,
            marker: { size: 5 }
          });
        }
      });

      Plotly.newPlot("orbit", traces, {
        paper_bgcolor: "#0a111d", plot_bgcolor: "#0a111d",
        scene: {
          bgcolor: "#0a111d",
          xaxis: { visible: false }, yaxis: { visible: false }, zaxis: { visible: false },
          aspectmode: "cube",
          camera: { eye: { x: 1.5, y: 1.5, z: 1.2 } }
        },
        margin: { l: 0, r: 0, t: 0, b: 0 },
        legend: { font: { color: "#9fb0c8", size: 10 }, bgcolor: "#0a111dcc", x: .02, y: .98 }
      }, { displayModeBar: false, responsive: true });
    }

function computeConjunctions(satellites) {
      const events = [];
      const now = new Date();

      const STEP_MINUTES = 2;
      const HOURS_AHEAD = 24;
      const totalSteps = (HOURS_AHEAD * 60) / STEP_MINUTES;

      function getState(satrec, time) {
        const result = satellite.propagate(satrec, time);

        if (!result.position || !result.velocity) {
          return null;
        }

        return {
          position: result.position,
          velocity: result.velocity
        };
      }

      function distanceBetween(posA, posB) {
        const dx = posA.x - posB.x;
        const dy = posA.y - posB.y;
        const dz = posA.z - posB.z;

        return Math.sqrt(dx * dx + dy * dy + dz * dz);
      }

      function relativeVelocity(velA, velB) {
        const vx = velA.x - velB.x;
        const vy = velA.y - velB.y;
        const vz = velA.z - velB.z;

        return Math.sqrt(vx * vx + vy * vy + vz * vz);
      }

      for (let i = 0; i < satellites.length; i++) {
        for (let j = i + 1; j < satellites.length; j++) {
          let minimumDistance = Infinity;
          let tcaTime = null;
          let tcaRelativeVelocity = 0;

          for (let step = 0; step <= totalSteps; step++) {
            const time = new Date(
              now.getTime() + step * STEP_MINUTES * 60 * 1000
            );

            const stateA = getState(satellites[i].satrec, time);
            const stateB = getState(satellites[j].satrec, time);

            if (!stateA || !stateB) continue;

            const distance = distanceBetween(
              stateA.position,
              stateB.position
            );

            if (distance < minimumDistance) {
              minimumDistance = distance;
              tcaTime = time;

              tcaRelativeVelocity = relativeVelocity(
                stateA.velocity,
                stateB.velocity
              );
            }
          }

          if (!tcaTime || !isFinite(minimumDistance)) {
            continue;
          }

          const timeToTcaMinutes =
            (tcaTime.getTime() - now.getTime()) / (60 * 1000);

          let riskLevel = "LOW";

          if (minimumDistance < 50) {
            riskLevel = "HIGH";
          } else if (minimumDistance < 500) {
            riskLevel = "MEDIUM";
          }

          // FIX: round the raw minutes value once here so every consumer
          // (card + table) shows the same, consistent number instead of the
          // card showing an unrounded float while the table showed toFixed(0).
          const roundedTcaMinutes = Math.max(0, Math.round(timeToTcaMinutes));

          events.push({
            objA: satellites[i].name,
            objB: satellites[j].name,
            dist: minimumDistance.toFixed(1),
            distValue: minimumDistance,
            tca: `${roundedTcaMinutes} min`,
            tcaValue: roundedTcaMinutes,
            relVel: tcaRelativeVelocity.toFixed(2),
            risk: riskLevel,
            tcaDate: tcaTime
          });
        }
      }

      return events.sort((a, b) => a.tcaValue - b.tcaValue);
    }

    // FIX: risk score is now derived from the actual closest-approach distance
    // instead of being a fixed 87/54/18 magic number that never reflected the
    // real event, and the ring's conic-gradient is now set inline so the arc
    // visually matches the score instead of always showing a static ~87% red arc.
    function riskScoreFromDistance(distanceKm) {
      // Map distance to a 0-100 "risk score": closer = higher score.
      // <10km -> ~99, 50km -> ~90, 500km -> ~50, >=2000km -> ~5
      const clamped = Math.max(0, Math.min(distanceKm, 2000));
      const score = 100 - (clamped / 2000) * 95;
      return Math.round(Math.max(1, Math.min(99, score)));
    }

    function updateRiskCircle(score, riskLevel) {
      const colorVar = riskLevel === "HIGH" ? "var(--red)" : riskLevel === "MEDIUM" ? "var(--orange)" : "var(--green)";
      const circle = document.getElementById("riskCircle");
      circle.style.background = `conic-gradient(${colorVar} 0 ${score}%, #172236 ${score}% 100%)`;
    }

    function renderConjunctions(events) {
      const tbody = document.getElementById("eventRows");
      tbody.innerHTML = "";

      // Cards data updating
      document.getElementById("cardConjunctions").innerText = events.length;
      const highRiskEvents = events.filter(e => e.risk === "HIGH");
      document.getElementById("cardHighRisk").innerText = highRiskEvents.length.toString().padStart(2, '0');

      if (events.length > 0) {
        const next = events[0];
        document.getElementById("cardNextTca").innerHTML = `${next.tcaValue}<span style="font-size:14px"> min</span>`;
        document.getElementById("cardNextPair").innerText = `${next.objA} ↔ ${next.objB}`;

        // Populate Selected Risk Monitor Panel with top event
        const score = riskScoreFromDistance(next.distValue);
        document.getElementById("riskScore").innerText = score;
        document.getElementById("riskLevel").innerText = `${next.risk} RISK`;
        document.getElementById("riskDist").innerText = `${next.dist} km`;
        document.getElementById("riskTca").innerText = next.tca;
        document.getElementById("riskVel").innerText = `${next.relVel} km/s`;
        document.getElementById("riskObjA").innerText = next.objA;
        document.getElementById("riskObjB").innerText = next.objB;
        document.getElementById("riskBadge").className = `badge ${next.risk.toLowerCase()}`;
        document.getElementById("riskBadge").innerText = next.risk;
        updateRiskCircle(score, next.risk);
      } else {
        // FIX: previously if there were zero events the risk panel stayed
        // stuck on "LOADING"/"CALCULATING" forever. Now it clearly reports
        // that no conjunctions were found.
        document.getElementById("riskScore").innerText = "0";
        document.getElementById("riskLevel").innerText = "NO EVENTS";
        document.getElementById("riskBadge").className = "badge low";
        document.getElementById("riskBadge").innerText = "NONE";
        updateRiskCircle(0, "LOW");
      }

      document.getElementById("conjunctionCount").innerText = `Next 24 hours • ${events.length} detected`;

      if (events.length === 0) {
        tbody.innerHTML = `<tr><td colspan="6" style="text-align:center; padding: 20px;">No conjunctions detected in the next 24 hours.</td></tr>`;
        return;
      }

      // Render Table Rows
      events.forEach(e => {
        const tr = document.createElement("tr");
        tr.innerHTML = `
          <td class="obj">${e.objA}</td>
          <td class="obj">${e.objB}</td>
          <td>${e.dist} km</td>
          <td>${e.tca}</td>
          <td>${e.relVel} km/s</td>
          <td><span class="badge ${e.risk.toLowerCase()}">${e.risk}</span></td>
        `;
        tbody.appendChild(tr);
      });
    }

    // Search bar listener
    document.getElementById("search").addEventListener("input", e => {
      const q = e.target.value.toLowerCase();
      document.querySelectorAll("#eventRows tr").forEach(r => r.style.display = r.innerText.toLowerCase().includes(q) ? "" : "none");
    });

    // Run dashboard initialization on page load
    window.addEventListener('DOMContentLoaded', initDashboard);
  </script>
</body>

</html>
