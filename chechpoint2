<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>OrbitGuard — Space Debris Tracking</title>
  <script src="https://cdn.plot.ly/plotly-2.35.2.min.js"></script>
  <!-- Added satellite.js for real TLE/OMM propagation. Pinned to 6.0.2, the first line
       that supports json2satrec() for parsing CelesTrak's JSON (OMM) records. -->
  <script src="https://cdn.jsdelivr.net/npm/satellite.js@6.0.2/dist/satellite.min.js"></script>
  <style>
    :root {
      --bg: #070b14;
      --panel: #0d1422;
      --panel2: #111a2b;
      --line: #1c2940;
      --text: #eaf2ff;
      --muted: #7f91ad;
      --cyan: #46d9ff;
      --blue: #5b8cff;
      --red: #ff526d;
      --orange: #ffad4d;
      --green: #42e6a4;
    }

    * {
      box-sizing: border-box
    }

    body {
      margin: 0;
      background: radial-gradient(circle at 70% 10%, #13243c 0, #070b14 38%);
      color: var(--text);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif
    }

    .app {
      display: flex;
      min-height: 100vh
    }

    .sidebar {
      width: 230px;
      background: rgba(7, 11, 20, .92);
      border-right: 1px solid var(--line);
      padding: 24px 16px;
      position: fixed;
      inset: 0 auto 0 0
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 11px;
      font-weight: 800;
      font-size: 19px;
      margin: 4px 10px 35px
    }

    .logoMark {
      width: 34px;
      height: 34px;
      border: 1px solid #2b7190;
      border-radius: 11px;
      display: grid;
      place-items: center;
      color: var(--cyan);
      box-shadow: 0 0 24px #46d9ff22
    }

    .navTitle {
      font-size: 10px;
      color: #50617a;
      letter-spacing: 1.6px;
      margin: 22px 12px 9px;
      text-transform: uppercase
    }

    .nav a {
      display: flex;
      gap: 12px;
      align-items: center;
      padding: 11px 12px;
      border-radius: 10px;
      color: var(--muted);
      text-decoration: none;
      font-size: 13px;
      margin: 3px 0
    }

    .nav a.active,
    .nav a:hover {
      background: #142238;
      color: #fff
    }

    .nav a.active {
      box-shadow: inset 2px 0 var(--cyan)
    }

    .system {
      position: absolute;
      bottom: 22px;
      left: 18px;
      right: 18px;
      padding: 13px;
      border: 1px solid var(--line);
      border-radius: 12px;
      background: #0c1320
    }

    .dot {
      display: inline-block;
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--green);
      box-shadow: 0 0 10px var(--green);
      margin-right: 7px
    }

    .main {
      margin-left: 230px;
      width: calc(100% - 230px);
      padding: 25px 30px
    }

    .top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 23px
    }

    .eyebrow {
      font-size: 11px;
      color: var(--cyan);
      letter-spacing: 1.8px;
      text-transform: uppercase
    }

    h1 {
      margin: 5px 0 0;
      font-size: 27px
    }

    .topRight {
      display: flex;
      align-items: center;
      gap: 12px
    }

    .live {
      font-size: 12px;
      color: #a9b9cf;
      border: 1px solid var(--line);
      padding: 9px 12px;
      border-radius: 9px;
      background: #0c1422
    }

    .search {
      background: #0d1524;
      border: 1px solid var(--line);
      color: #fff;
      padding: 10px 13px;
      border-radius: 9px;
      outline: none;
      width: 190px
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 14px;
      margin-bottom: 16px
    }

    .card {
      background: linear-gradient(145deg, #0e1727, #0a111d);
      border: 1px solid var(--line);
      border-radius: 14px;
      padding: 17px
    }

    .cardHead {
      display: flex;
      justify-content: space-between;
      color: var(--muted);
      font-size: 12px
    }

    .icon {
      color: var(--cyan);
      font-size: 16px
    }

    .value {
      font-size: 28px;
      font-weight: 750;
      margin: 9px 0 3px
    }

    .sub {
      font-size: 11px;
      color: var(--muted)
    }

    .up {
      color: var(--green)
    }

    .grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 310px;
      gap: 16px
    }

    .panel {
      background: rgba(10, 17, 29, .88);
      border: 1px solid var(--line);
      border-radius: 14px;
      overflow: hidden
    }

    .panelTitle {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 15px 17px;
      border-bottom: 1px solid var(--line)
    }

    .panelTitle strong {
      font-size: 13px
    }

    .panelTitle span {
      font-size: 11px;
      color: var(--muted)
    }

    #orbit {
      height: 440px
    }

    .riskBody {
      padding: 22px
    }

    .riskCircle {
      width: 158px;
      height: 158px;
      border-radius: 50%;
      margin: 4px auto 20px;
      display: grid;
      place-items: center;
      /* Default/fallback gradient; actual arc is set inline in JS based on the
         live risk score, so this only shows before data has loaded. */
      background: conic-gradient(var(--muted) 0 0%, #172236 0% 100%);
      position: relative;
      transition: background 0.4s ease;
    }

    .riskCircle:after {
      content: "";
      position: absolute;
      width: 128px;
      height: 128px;
      border-radius: 50%;
      background: #0b1320
    }

    .riskNum {
      position: relative;
      z-index: 2;
      text-align: center
    }

    .riskNum b {
      display: block;
      font-size: 40px
    }

    .riskNum small {
      font-size: 10px;
      color: var(--red);
      letter-spacing: 2px
    }

    .details {
      border-top: 1px solid var(--line);
      padding-top: 14px
    }

    .row {
      display: flex;
      justify-content: space-between;
      padding: 9px 0;
      font-size: 12px
    }

    .row span:first-child {
      color: var(--muted)
    }

    .badge {
      padding: 4px 8px;
      border-radius: 6px;
      font-size: 10px;
      font-weight: 700
    }

    .high {
      background: #ff526d18;
      color: var(--red)
    }

    .medium {
      background: #ffad4d18;
      color: var(--orange)
    }

    .low {
      background: #42e6a418;
      color: var(--green)
    }

    .events {
      margin-top: 16px
    }

    .tableWrap {
      overflow: auto
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 12px
    }

    th,
    td {
      text-align: left;
      padding: 12px 15px;
      border-bottom: 1px solid #152136
    }

    th {
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: #60718a;
      font-weight: 600
    }

    td {
      color: #cbd7e8
    }

    tr:hover {
      background: #101a2b
    }

    .obj {
      color: #fff;
      font-weight: 600
    }

    .muted {
      color: var(--muted)
    }

    .footerNote {
      padding: 11px 15px;
      color: #586b86;
      font-size: 10px
    }

    @media(max-width:1000px) {
      .sidebar {
        width: 72px
      }

      .logo span,
      .nav a span,
      .navTitle,
      .system {
        display: none
      }

      .main {
        margin-left: 72px;
        width: calc(100% - 72px)
      }

      .cards {
        grid-template-columns: repeat(2, 1fr)
      }

      .grid {
        grid-template-columns: 1fr
      }
    }
